<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:background="#0D0D0D"
    android:padding="12dp"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Top row: player name + type badge + date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/txtPlayerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F0F0F0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtTransferType"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:textColor="#181818"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginHorizontal="8dp" />

        <TextView
            android:id="@+id/txtTransferDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Transfer arrow row: From → To -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- From Team -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgFromTeam"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/txtFromTeam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B0BEC5"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Arrow -->
        <TextView
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="→"
            android:textColor="#AAFF00"
            android:textSize="20sp"
            android:gravity="center" />

        <!-- To Team -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgToTeam"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/txtToTeam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B0BEC5"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Loan label -->
    <TextView
        android:id="@+id/txtLoanIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#181818"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="#FF9800"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- player photo hidden (no photo in transfers API) -->
    <ImageView
        android:id="@+id/imgPlayerPhoto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- league name hidden field kept for adapter compat -->
    <TextView
        android:id="@+id/txtLeagueName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>

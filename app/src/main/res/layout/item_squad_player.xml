<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="#0D0D0D"
    android:layout_marginBottom="1dp"
    android:foreground="?android:attr/selectableItemBackground">

<TextView
        android:id="@+id/txtPlayerNumber"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:textColor="#AAFF00"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#181818"
        android:layout_marginEnd="10dp" />

<ImageView
        android:id="@+id/imgPlayerPhoto"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:background="#1E1E1E"
        android:layout_marginEnd="10dp" />

<LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtPlayerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F0F0F0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtPlayerPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:layout_marginTop="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/txtPlayerNationality"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#757575"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtPlayerAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#757575"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

<TextView
        android:id="@+id/txtPlayerPhysical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#757575"
        android:textSize="11sp"
        android:layout_marginStart="8dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181818">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="No statistics available"
            android:textColor="#888888"
            android:textSize="15sp"
            android:visibility="gone" />

<TextView
            android:id="@+id/tvSeasonLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SEASON 2024/25"
            android:textColor="#666666"
            android:textSize="11sp"
            android:fontFamily="@font/font_oswald_bold"
            android:letterSpacing="0.10"
            android:paddingBottom="12dp"
            android:visibility="gone" />

<TextView
            android:id="@+id/lblAttack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚽  ATTACK"
            android:textColor="#AAFF00"
            android:textSize="12sp"
            android:fontFamily="@font/font_oswald_bold"
            android:letterSpacing="0.12"
            android:paddingBottom="6dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cardAttack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Goals"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvGoals" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#AAFF00" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A2A" android:layout_marginStart="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Assists"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvAssists" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#AAFF00" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A2A" android:layout_marginStart="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Shots on Target"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvShotsOn" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A2A" android:layout_marginStart="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Total Shots"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvShotsTotal" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A2A" android:layout_marginStart="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Key Passes"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvKeyPasses" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
        </LinearLayout>

<TextView
            android:id="@+id/lblMidfield"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄  MIDFIELD"
            android:textColor="#AAFF00"
            android:textSize="12sp"
            android:fontFamily="@font/font_oswald_bold"
            android:letterSpacing="0.12"
            android:paddingBottom="6dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cardMidfield"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Appearances"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvAppearances" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A2A" android:layout_marginStart="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Minutes Played"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvMinutes" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A2A" android:layout_marginStart="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Pass Accuracy"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvPassAccuracy" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A2A" android:layout_marginStart="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Dribbles (Success)"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvDribbles" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
        </LinearLayout>

<TextView
            android:id="@+id/lblDefense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡  DEFENSE"
            android:textColor="#AAFF00"
            android:textSize="12sp"
            android:fontFamily="@font/font_oswald_bold"
            android:letterSpacing="0.12"
            android:paddingBottom="6dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cardDefense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Tackles"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvTackles" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A2A" android:layout_marginStart="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Interceptions"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvInterceptions" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A2A" android:layout_marginStart="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Duels Won"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvDuelsWon" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A2A" android:layout_marginStart="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Yellow Cards"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvYellow" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFEB3B" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A2A" android:layout_marginStart="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Red Cards"
                    android:textColor="#AAAAAA" android:textSize="14sp" />
                <TextView android:id="@+id/tvRed" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#F44336" android:textSize="16sp" android:textStyle="bold"
                    android:fontFamily="@font/font_oswald_bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
